# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env
.env*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# claude code / plugins
# Default: ignore everything under .claude/. Carve out Nightwork-authored
# build-system code (skills, agents, commands, hooks, settings) so the
# anti-drift mechanism propagates via git. Third-party skills/agents/commands
# (ECC, GSD, Superpowers, frontend-design, impeccable, shadcn-ui, etc.) stay
# local because they are re-installable from upstream.
.claude/*
!.claude/settings.json

# Skills: only nightwork-* skills are tracked
!.claude/skills/
.claude/skills/*
!.claude/skills/nightwork-design/
!.claude/skills/nightwork-design/**
!.claude/skills/nightwork-*/
!.claude/skills/nightwork-*/**

# Agents: only nightwork-* agents are tracked + project-specific GSD
# extensions added by stage-1.5c-verification-harness Plan 7 (per D-10) +
# Nightwork-customized gsd-executor (per nwrp179: mcp__supabase__* tools added
# for DB-touching plan execution).
# Other gsd-* agents come from the GSD upstream/plugin (not tracked here).
!.claude/agents/
.claude/agents/*
!.claude/agents/nightwork-*.md
!.claude/agents/gsd-research-standards.md
!.claude/agents/gsd-fix-executor.md
!.claude/agents/gsd-executor.md

# Commands: nightwork-* + the np / nx / ns wrappers
!.claude/commands/
.claude/commands/*
!.claude/commands/nightwork-*.md
!.claude/commands/np.md
!.claude/commands/nx.md
!.claude/commands/ns.md

# Hooks: only nightwork-* hooks are tracked
!.claude/hooks/
.claude/hooks/*
!.claude/hooks/nightwork-*.sh

.agents/
skills-lock.json

# screenshots (local only, never committed)
/screenshots/

# Playwright smoke output (wave-d-smoke.ts + future Layer 4 framework runs;
# per-run screenshots + JSON; ephemeral, never committed) — per Wave-D D-4
# iter-2 §4.11.
/.playwright-output/

# test invoices (local only — real client PDFs, never committed)
/test-invoices/

# classifier test fixtures (local only — real Ross Built PDFs, never committed per preflight R8)
/__tests__/fixtures/classifier/.local/

# Drummond fixture extraction working files (local only — pre-substitution real names per nwrp33 C5)
/scripts/drummond-invoice-fields.json
/scripts/drummond-*.local.json

# classifier eval intermediate output (regenerable, varies per run — final results are pasted into qa-branch3-phase3.2-v2.md)
/qa-reports/.eval/

# /.planning/ — local planning artifacts; canonical docs are whitelisted below.
# Transient outputs (qa-runs, plan-reviews, e2e-runs, design-checks,
# custodian-runs, drift-checks, propagate) are regenerated each phase and
# stay local. Sensitive scan output (audits) and business-data fixtures
# (fixtures) also stay local.
/.planning/*
!/.planning/MASTER-PLAN.md
!/.planning/CONTEXT.md
!/.planning/PROJECT.md
!/.planning/ROADMAP.md
!/.planning/REQUIREMENTS.md
!/.planning/STATE.md
!/.planning/deployment.md
!/.planning/config.json
!/.planning/lessons.md
# calibration-log.md — append-only phase retrospectives written by
# nightwork-custodian at post-ship. Read by /np orchestrator at next-phase
# scope time for dynamic prompt density / parallelism tuning. Per D-13/D-14.
!/.planning/calibration-log.md
!/.planning/calibration-log-schema.md
!/.planning/architecture/
!/.planning/architecture/**
!/.planning/milestones/
!/.planning/milestones/**
# expansions/ — phase contracts (EXPANDED-SCOPE.md, MANUAL-CHECKLIST.md,
# SETUP-COMPLETE.md, PREFLIGHT-PASS.md/FAIL.md). These must sync across
# PCs because /np reads EXPANDED-SCOPE and /nx reads SETUP-COMPLETE. Per D-018.
!/.planning/expansions/
!/.planning/expansions/**
# templates/ — canonical author templates (criteria, plan, etc.). Synced via
# git so /np pulls templates from any PC. Per stage-1.5c-vh D-17/D-18.
!/.planning/templates/
!/.planning/templates/**
# phases/ — phase artifacts (DISCUSSION.md, SPEC.md, PLAN.md, PLAN-REVIEW.md,
# MANIFEST.md, STATE.md). These must sync across PCs because /np produces
# them and /nx reads them. Per D-018 + GSD convention.
!/.planning/phases/
!/.planning/phases/**
# tech-debt/ — forward-looking cleanup entries (TD-NN-<slug>.md) born from
# phase plan-reviews/QA findings, referenced by later cleanup waves
# (e.g. Wave 1.1-Lite). Must sync across PCs because future plans declare
# TD entries as deliverables / cross-references. Per nwrp129 (Wave-D D-2
# iter-3 finding — TD-WD-01 surfaced the missing whitelist).
!/.planning/tech-debt/
!/.planning/tech-debt/**
# runbooks/ — operator-facing rollback + recovery procedures referenced by
# down migrations + plan §11 rollback sections. Must sync across PCs because
# down migrations cross-reference these files (see e.g. 00101_drop_jobs_client_
# columns.down.sql + wave-b-slice-1-rollback.md). Per F1-Wave-B Slice-1
# B-1a-bis ITER-2-PATCHES §3.10 codification.
!/.planning/runbooks/
!/.planning/runbooks/**
# grounding-pass/ — multi-agent read-only inventory output (per nwrp223 §10-44).
# 4 detailed agent reports (A-D) + GROUNDED-INVENTORY.md synthesis. Must sync
# across PCs because the synthesis is the foundation for the launch plan Jake
# reviews + builds on. Content sensitivity scan: architectural inventory only;
# file paths + status labels + plain-language gap analysis; no credentials, no
# customer data. Same whitelist pattern as decisions-pending/decisions-resolved
# (nwrp169 Q-W9 Option a precedent) + tech-debt/ (nwrp129 TD-WD-01 precedent).
!/.planning/grounding-pass/
!/.planning/grounding-pass/**
# ground-truth/ — Ground-Truth-Verification phase artifacts (per nwrp255-256,
# 2026-05-29). PART-1-INVENTORY.md + future PART-2 / PART-3 / consolidated
# GROUND-TRUTH-VERIFICATION.md. Successor inventory to grounding-pass/ (which
# was authored pre-Phase-1 and is now superseded by this phase per the drift
# tracked in MASTER-PLAN §12 GTV sequencing). Must sync across PCs because
# this becomes the authoritative "where we are" doc that the finish-line plan
# is built from. Same whitelist pattern as grounding-pass/ + launch/. Content
# sensitivity scan: architectural inventory + flow verification findings + row
# counts; no credentials, no PII, no customer data beyond table-level counts.
!/.planning/ground-truth/
!/.planning/ground-truth/**
# launch/ — authoritative scope-lock + (forthcoming) launch plan artifacts for
# the first internal Ross Built deployment (per nwrp225). Must sync across PCs
# because the scope-lock survives /clear + grounds subsequent launch-plan
# drafts. Content sensitivity scan: architectural scope only; no credentials,
# no PII, no customer data. Same whitelist pattern as grounding-pass/ (nwrp223
# precedent) + decisions-pending/decisions-resolved (nwrp169 Q-W9 Option a)
# + tech-debt/ (nwrp129 TD-WD-01).
!/.planning/launch/
!/.planning/launch/**
# decisions-pending/ + decisions-resolved/ — investigative decision briefs
# (e.g. user-identity-fk-convention BRIEF surfaced D-078; F1+-1 production
# domain BRIEF + F1+-2 SSO posture BRIEF). Must sync across PCs because Jake
# reviews on multiple PCs + briefs are the canonical SOURCE for D-### entries
# in MASTER-PLAN.md. Content sensitivity scan (nwrp168 ITEM 4) confirmed clean
# — architectural decision text only; no PII / customer data / credentials.
# Per nwrp169 Q-W9 disposition (Option a — whitelist both directories).
!/.planning/decisions-pending/
!/.planning/decisions-pending/**
!/.planning/decisions-resolved/
!/.planning/decisions-resolved/**
# design/ — canonical Nightwork design system documents (PHILOSOPHY.md,
# SYSTEM.md, COMPONENTS.md, PATTERNS.md, PROPAGATION-RULES.md,
# CONTRAST-MATRIX.md). Produced by stage-1.5a; consumed by every later UI
# phase + by skills (nightwork-design, nightwork-design-tokens,
# nightwork-ui-template). Must sync across PCs. Per D-018 + SPEC §2.
!/.planning/design/
!/.planning/design/**
!/.planning/coherence/
!/.planning/coherence/**
# screenshots are regenerable + heavy — keep them out of git (re-ignored after the coherence whitelist)
/.planning/coherence/**/screenshots/
# research/ — outputs of gsd-research-standards (this phase + future phases).
# Industry-canonical rules + cache files. Must sync across PCs so cache reuse
# works cross-phase. Per stage-1.5c-verification-harness D-10/D-11.
!/.planning/research/
!/.planning/research/**
# process/ — pipeline + workflow design documents (PLANNING-PIPELINE-TIERING.md
# + future process artifacts). Survives /clear; informs every subsequent /np
# dispatch. Must sync across PCs because tiering design specifies LOW/MEDIUM/HIGH
# reviewer sets that the pipeline reads from. Per TD-PLANNING-PIPELINE-SEVERITY-
# TIERING (nwrp233+237+238).
!/.planning/process/
!/.planning/process/**
# verification/ — runs/ are gitignored (per-commit harness reports clutter
# git history); reports/ and standards/ are tracked (per-phase final reports
# + standards rules library). Per D-15/D-16 (stage-1.5c verification harness).
!/.planning/verification/
!/.planning/verification/standards/
!/.planning/verification/standards/**
!/.planning/verification/reports/
!/.planning/verification/reports/**
/.planning/verification/runs/
/.planning/verification/runs/**
# Harness auth bootstrap output (storageState — contains valid session
# tokens for harness-fixture@nightwork.local; never commit). Regenerated
# per CI run via scripts/harness-auth-bootstrap.ts.
/.planning/verification/auth/
/.planning/verification/auth/**

# smoke + E2E runtime logs (ephemeral, regenerated each run)
/e2e-state.json
/e2e-*.log
/e2e-*-log.json
/e2e-findings-running.md
/smoke-test-probe*.json
/smoke-test-results.json
